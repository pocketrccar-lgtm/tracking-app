# Copy to .env and fill in. Easiest: `vercel env pull .env` after `vercel link`.
# Supabase + Prisma pattern: pooled URL for app queries, direct for migrations.
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:6543/DBNAME?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Claude API key for voice->task AI autofill (/api/extract-task)
# Get one at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."
